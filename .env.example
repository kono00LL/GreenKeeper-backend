PORT=8080
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
DATA_DIRECTORY=./data

# Browser frontend origins (comma-separated)
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Optional: enables photo-based plant identification
PLANTNET_API_KEY=

# Image storage: local (default) or cos. COS may remain private.
IMAGE_STORAGE=local
COS_BUCKET=greenkeeper-1385540619
COS_REGION=ap-shanghai
# Backend only. Use a CAM sub-user restricted to this bucket's uploads/*.
COS_SECRET_ID=
COS_SECRET_KEY=
