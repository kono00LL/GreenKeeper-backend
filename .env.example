PORT=8080
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
DATA_DIRECTORY=./data

# Tencent Cloud SES transactional email (email verification codes)
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
SES_REGION=ap-guangzhou
SES_FROM_EMAIL=GreenKeeper <noreply@mail.example.com>
SES_TEMPLATE_ID=
EMAIL_CODE_SECRET=replace-with-a-separate-long-random-secret

# WeChat Open Platform Android login. Keep the secret on the backend only.
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Browser frontend origins (comma-separated)
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Optional: enables photo-based plant identification
PLANTNET_API_KEY=

# Optional: enables authenticated AI plant-care advice
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_MS=30000

# Image storage: local (default) or cos. COS may remain private.
IMAGE_STORAGE=local
COS_BUCKET=greenkeeper-1385776814
COS_REGION=ap-shanghai
# Backend only. Use a CAM sub-user restricted to this bucket's uploads/*.
COS_SECRET_ID=
COS_SECRET_KEY=

# Optional plant cover import paths. Defaults: bundled manifest and DATA_DIRECTORY.
# PLANT_IMAGES_MANIFEST=./src/plants/data/plant-images-v1.json
# PLANT_IMAGES_DIRECTORY=./data
